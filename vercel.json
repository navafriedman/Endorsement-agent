{
  "buildCommand": "cd voter-match && npm install && npm run build",
  "outputDirectory": "voter-match/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/questionnaire-editor-ts/api" }
  ],
  "functions": {
    "questionnaire-editor-ts/api/index.ts": {
      "runtime": "@vercel/node@3"
    }
  }
}
