{
  "buildCommand": "cd ballot-page-prototype && npm install && npm run build",
  "outputDirectory": "ballot-page-prototype/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/questionnaire-editor-ts/api" }
  ],
  "functions": {
    "questionnaire-editor-ts/api/index.ts": {
      "runtime": "@vercel/node@3"
    }
  }
}
